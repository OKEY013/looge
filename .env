# Environment Variables
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/groupbuy

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production-environment
JWT_EXPIRES_IN=7d

# Admin Default Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_EMAIL=admin@groupbuy.com

# System Settings
DEFAULT_DAILY_SIGNIN_REWARD=100
REFERRAL_COMMISSION_RATE=0.05

# Group Buy Settings
DRAW_TIMES=13:00,15:00,17:00,19:00

# Virtual Accounts
VIRTUAL_ACCOUNTS_COUNT=5000

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
